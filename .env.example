# Copy to .env on the VPS. Never commit the populated file.
DASHBOARD_TIMEZONE=Asia/Shanghai
DASHBOARD_CITY=北京
DASHBOARD_CITY_LABEL=北京
DASHBOARD_LATITUDE=39.9042
DASHBOARD_LONGITUDE=116.4074
DASHBOARD_INGEST_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# frame_width/frame_height are the physical PNG dimensions. A landscape Kindle
# renders sideways and rotates into its portrait framebuffer before download.
DASHBOARD_DEVICES_JSON=[{"id":"kpw3","token":"REPLACE_WITH_64_HEX_CHARACTERS","frame_width":1072,"frame_height":1448,"layout":"portrait","rotate":0},{"id":"oasis1","token":"REPLACE_WITH_64_HEX_CHARACTERS","frame_width":1080,"frame_height":1440,"layout":"landscape","rotate":90},{"id":"android42","token":"REPLACE_WITH_64_HEX_CHARACTERS","frame_width":800,"frame_height":480,"layout":"landscape","rotate":0},{"id":"iphone","token":"REPLACE_WITH_64_HEX_CHARACTERS","frame_width":1179,"frame_height":2556,"layout":"responsive","rotate":0}]
