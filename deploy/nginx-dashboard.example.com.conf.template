server {
    listen 80;
    server_name dashboard.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/remote-eink-dashboard;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dashboard.example.com;

    # Fill these with the certificate paths issued after the A record resolves.
    ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Device tokens are path components. Do not persist them in access logs.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8486;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }
}
