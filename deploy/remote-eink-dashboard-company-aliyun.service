[Unit]
Description=Push company Alibaba Cloud account balance to Remote E-ink Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=remote-eink-status
Group=remote-eink-status
EnvironmentFile=/etc/remote-eink-dashboard/company.env
EnvironmentFile=-/etc/remote-eink-dashboard/company-aliyun.env
ExecStart=/usr/bin/python3.11 /usr/local/sbin/eink-dashboard-aliyun-balance.py
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
